# 独立执行器（script-server）环境变量示例
# 用法：复制为 .env（同目录），至少填 WF_SCRIPT_TOKEN，然后 start-script-server.bat
# 注意：.env 含凭据，不要提交、不要放进共享目录；Windows 上建议把目录 ACL 收紧到运行账户。

# ── 必填：调用方鉴权 token ─────────────────────────────────────
# 生成：python -c "import secrets;print(secrets.token_hex(24))"
# 平台「设备管理」里登记的 token 必须与此一致。
# 3.2.0 起 fail-closed：token 为空且监听非回环地址（如 0.0.0.0）时直接拒绝启动；
# 只有监听 127.0.0.1 调试时才允许空 token（仍会打 WARNING）。
WF_SCRIPT_TOKEN=

# 生产建议 1：token 为空时拒绝启动（避免忘配变成谁都能执行）
WF_SCRIPT_REQUIRE_TOKEN=1

# 仅隔离网络/本机调试：显式允许「空 token + 对外监听」（不推荐，默认 0）
# WF_SCRIPT_ALLOW_INSECURE=0

# ── 脚本目录与路径边界（默认 fail-closed）──────────────────────
# 脚本根目录；相对路径按此解析。默认 = 本目录上一级的 scripts/
# WF_SCRIPTS_DIR=C:\ScriptData\scripts
#
# 允许执行「脚本目录之外」的绝对路径（分号分隔）；默认不允许（403）。
# 例：WF_ALLOWED_SCRIPT_ROOTS=D:\other-scripts;E:\jobs
# WF_ALLOWED_SCRIPT_ROOTS=
#
# 允许 /scan 扫描的目录（分号分隔）；默认只允许 WF_SCRIPTS_DIR。
# WF_SCAN_ALLOWED_ROOTS=
# /scan 单次返回文件数上限（默认 2000，超出 truncated=true）
# WF_SCAN_MAX_FILES=2000
# /scan 递归深度上限（默认 8）
# WF_SCAN_MAX_DEPTH=8
# /scan 默认返回绝对路径（1=旧行为；默认 0，返回相对路径，path 可直接回传 /run）
# WF_SCAN_ABSOLUTE_PATHS=0

# ── 响应/请求口径（3.3.2 起）────────────────────────────────────
# 脚本 exit 1（部分成功）返回的 code：默认 206；平台仍按 500 判定失败时设为 500
# WF_PARTIAL_CODE=206
# /run 出现未知字段时：0=告警忽略（默认，向前兼容）；1=直接 400（确认调用方无多余字段后开启）
# WF_STRICT_FIELDS=0
# /health/ready 写探测结果的缓存秒数（默认 300；0=每次轮询都写盘）
# WF_READY_PROBE_TTL_SECONDS=300

# ── 资源保护 ────────────────────────────────────────────────────
# 同时执行的脚本数上限（默认 4；超出返回 HTTP 429 + Retry-After: 5）
# WF_MAX_CONCURRENCY=4
# /run 传 "block_strategy":"queue" 时，最多排队等空槽的秒数（默认 30；同时不超过本次 timeout_seconds）
# WF_QUEUE_MAX_WAIT_SECONDS=30
# 排队请求上限（默认 16；0=不限制；满了立即 429 + Retry-After: 5，不再占用连接等待）
# WF_QUEUE_MAX_DEPTH=16
# 单流 stdout/stderr 捕获上限（字节，默认 8MB，超出截断并标 truncated）
# WF_MAX_OUTPUT_BYTES=8388608
# 幂等/台账状态目录；默认 = <脚本目录的上一级>/.script_server_state（必须可写）
# WF_SCRIPT_STATE_DIR=

# ── 请求 env 注入限制（3.2.0 起）────────────────────────────────
# /run 的 env 只允许业务变量；服务级/解释器/命令搜索路径变量（WF_SCRIPT_*、PYTHONPATH、
# PATH、COMSPEC、SystemRoot 等）会被 400 拒绝，无法通过请求覆盖。
# 如另有业务变量名需要禁止，在这里追加（逗号分隔）：
# WF_SCRIPT_ENV_DENY=WF_SCRIPT_TOKEN

# ── 执行器自身 ──────────────────────────────────────────────────
# 监听地址/端口：serve.py 默认 0.0.0.0:9000；可用 WF_BIND_HOST 覆盖地址，
# 或在命令行用 `python deploy\serve.py --host 127.0.0.1 --port 9000`。
# 注意：--workers 必须为 1（3.2.0 起检测到多 worker 会直接拒绝启动）。
# 升级/重启前建议先 POST /drain（带 token）排空在跑任务，再重启，减少中断。
