@echo off
rem ==========================================================================
rem  Start script-server (executor) via PM2.
rem  -nopause : non-interactive (autostart / scripts); do not wait for key press
rem  Repo layout  -> uses <repo>\ecosystem.config.js + <repo>\.env
rem  Standalone   -> uses .\ecosystem.config.js + .\.env (new device, executor only)
rem  Keep this file ASCII-only: cmd parses .bat files in the OEM code page.
rem ==========================================================================
setlocal EnableExtensions
chcp 65001 >nul
title Script-Server (PM2)
cd /d "%~dp0"

echo [1/4] Checking Python / PM2 ...
where python >nul 2>&1
if errorlevel 1 goto :no_python
where pm2 >nul 2>&1
if errorlevel 1 goto :no_pm2

set "ECO=%~dp0..\ecosystem.config.js"
set "ECODIR=%~dp0.."
if exist "%ECO%" goto :eco_ready
set "ECO=%~dp0ecosystem.config.js"
set "ECODIR=%~dp0"
if exist "%ECO%" goto :eco_ready
goto :no_eco
:eco_ready

echo [2/4] Restarting script-server via PM2 ...
echo       config: %ECO%
pushd "%ECODIR%"
call pm2 delete script-server >nul 2>&1
call pm2 start "%ECO%" --only script-server
set "RC=%ERRORLEVEL%"
popd
if not "%RC%"=="0" goto :pm2_failed
call pm2 save >nul 2>&1

echo [3/4] Waiting for http://127.0.0.1:9000/health ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ok=$false; $last=''; for($i=0;$i -lt 40;$i++){ try { $r=Invoke-WebRequest -UseBasicParsing -Uri http://127.0.0.1:9000/health -TimeoutSec 3; if($r.StatusCode -eq 200){ $ok=$true; $last=$r.Content; break } } catch { $last=$_.Exception.Message }; Start-Sleep -Seconds 1 }; if($ok){ Write-Host ('OK ' + $last) } else { Write-Host ('[WARN] /health not 200 in 40s: ' + $last); exit 1 }"
if errorlevel 1 goto :health_failed

echo [4/4] Done.
call pm2 list
if /i not "%~1"=="-nopause" pause
exit /b 0

:no_python
echo [ERROR] Python not found in PATH.
echo         Install Python 3.10+ (3.12 tested) and tick "Add Python to PATH".
goto :fail

:no_pm2
echo [ERROR] pm2 not found.
echo         Install Node.js 18+ then run:  npm install -g pm2
goto :fail

:no_eco
echo [ERROR] ecosystem.config.js not found.
echo         Looked for:
echo           %~dp0..\ecosystem.config.js
echo           %~dp0ecosystem.config.js
echo         Keep this .bat inside the script-server folder.
goto :fail

:pm2_failed
echo [ERROR] pm2 start failed (exit %RC%). Common causes:
echo         - port 9000 already in use:  netstat -ano ^| findstr :9000  then  taskkill /F /T /PID ^<pid^>
echo         - missing Python packages:  python -m pip install -r requirements.txt
echo         - bad .env: check WF_SCRIPT_TOKEN / WF_SCRIPTS_DIR
goto :fail

:health_failed
echo [ERROR] script-server started but did not become healthy.
echo         Diagnostics:
echo           pm2 logs script-server --lines 50
echo           pm2 describe script-server
goto :fail

:fail
if /i not "%~1"=="-nopause" pause
exit /b 1
